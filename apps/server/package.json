{
  "name": "@memento/server",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "memento-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./main": {
      "memento-source": "./src/main.ts",
      "default": "./dist/main.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./main": "./dist/main.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "oxlint . --no-error-on-unmatched-pattern",
    "test": "NODE_OPTIONS=--conditions=memento-source vitest run --passWithNoTests",
    "dev": "node --env-file-if-exists=../../.env --conditions=memento-source --import tsx --watch src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@ensforge/core": "catalog:",
    "@ensforge/sdk": "catalog:",
    "@memento/api": "workspace:*",
    "@memento/application": "workspace:*",
    "@memento/contracts": "workspace:*",
    "@memento/database": "workspace:*",
    "@memento/privy": "workspace:*",
    "@memento/protocol": "workspace:*",
    "@memento/world-id": "workspace:*",
    "@rhinestone/sdk": "catalog:",
    "effect": "catalog:",
    "resend": "catalog:",
    "viem": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "klarity": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
