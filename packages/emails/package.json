{
  "name": "@memento/emails",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": {
      "memento-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./templates": {
      "memento-source": "./src/templates/index.ts",
      "default": "./dist/templates/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./templates": "./dist/templates/index.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "oxlint . --no-error-on-unmatched-pattern",
    "test": "NODE_OPTIONS=--conditions=memento-source vitest run",
    "preview": "email dev --dir src/templates --port 3002"
  },
  "dependencies": {
    "@memento/protocol": "workspace:*",
    "effect": "catalog:",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-email": "6.9.2",
    "resend": "catalog:"
  },
  "devDependencies": {
    "@react-email/ui": "6.9.2",
    "@types/node": "catalog:",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "klarity": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
