# Shared development/VPS configuration. Never commit .env.
PORT=3001
WEB_ORIGIN=https://memento.envoy1084.xyz
API_DOMAIN=api.memento.envoy1084.xyz
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
DATABASE_URL=postgresql://memento:replace-with-a-long-random-hex-password@localhost:5432/memento

# Two different 32-byte keys encoded as 64 hex characters (without 0x).
ENCRYPTION_KEY=
EMAIL_HMAC_KEY=

PRIVY_APP_ID=
PRIVY_APP_SECRET=
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_ENVIRONMENT=staging
WORLD_SIGNING_KEY=
RESEND_API_KEY=
EMAIL_FROM="Memento <gifts@your-verified-domain.example>"

# Contract addresses: packages/chain/src/deployments/sepolia.json
# World action and product limits: apps/server/src/config/product.ts
# Sepolia, compatible with the pinned ENSv2 post-audit-2 revision.
# Backend only: https://eth-sepolia.g.alchemy.com/v2/<your-key>
RPC_URL=
COORDINATOR_PRIVATE_KEY=
RHINESTONE_API_KEY=

# Public deployment settings. Keep the deployer key in a Foundry keystore, never this file.
CONTRACT_ADMIN=
COORDINATOR_ADDRESS=
